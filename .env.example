# Anthropic (required)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Anthropic (optional)
ANTHROPIC_MAX_TOKENS=512
ANTHROPIC_TEMPERATURE=0.3
TUTOR_SYSTEM_PROMPT_VERSION=v1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth (parent login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Playwright test auth bootstrap (optional, local/test only)
ENABLE_TEST_AUTH_BOOTSTRAP=0
PLAYWRIGHT_TEST_AUTH_SECRET=replace_with_random_secret
PLAYWRIGHT_TEST_AUTH_EMAIL=playwright-parent@example.test
PLAYWRIGHT_TEST_AUTH_REDIRECT_PATH=/auth/callback

# Google Speech (optional, enables cloud STT/TTS)
SPEECH_PROVIDER=google
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
GOOGLE_CLOUD_LOCATION=global
GOOGLE_STT_RECOGNIZER=_
GOOGLE_STT_LANGUAGE_CODE=en-US
GOOGLE_STT_MODEL=latest_short
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=en-US-Chirp3-HD-Achernar
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_SPEAKING_RATE=0.92
SPEECH_REQUEST_TIMEOUT_MS=12000
SPEECH_MAX_RETRIES=1
SPEECH_RETRY_BASE_DELAY_MS=250
# Max accepted audio bytes for /speech/transcribe (default 5 MiB, hard-bounded in server code)
SPEECH_TRANSCRIBE_MAX_AUDIO_BYTES=5242880
# Max accepted text length for /speech/synthesize after normalization (default 2000)
SPEECH_SYNTH_MAX_TEXT_LENGTH=2000
SPEECH_TELEMETRY_DISABLED=0

# Stream telemetry (optional)
STREAM_TELEMETRY_DISABLED=0
NEXT_PUBLIC_STREAM_TELEMETRY_DISABLED=0
# Stream transport mode: auto (default), realtime (require subscription), polling (force legacy polling)
STREAM_TRANSPORT_MODE=auto

# Client voice telemetry (optional)
NEXT_PUBLIC_VOICE_TELEMETRY_DISABLED=0

# Product analytics telemetry (optional)
PRODUCT_ANALYTICS_DISABLED=0
NEXT_PUBLIC_PRODUCT_ANALYTICS_DISABLED=0

# Rate limiting (optional)
# auto (default): use shared Supabase backend when available, otherwise in-memory fallback
# memory: force process-local limiter
# supabase: require shared Supabase limiter
RATE_LIMIT_BACKEND=auto

# COPPA consent controls (optional)
# 1 (default): require explicit parent consent before child profile creation/session start
# 0: disable consent gating (for local/dev fallback environments)
COPPA_CONSENT_REQUIRED=1
# 1: allow temporary fallback when COPPA schema migrations are missing (non-production only)
# 0 (default): fail closed if COPPA schema is unavailable
ALLOW_COPPA_SCHEMA_FALLBACK=0
# Policy version recorded in consent audit events
COPPA_POLICY_VERSION=2026-02-19
# Parent-facing policy URL shown in consent status payloads
COPPA_POLICY_URL=/privacy

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
